{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/chat.js": {
      "maxDuration": 300
    },
    "api/models.js": {
      "maxDuration": 60
    },
    "api/admin/activity.js": {
      "maxDuration": 15
    },
    "api/warmup.js": {
      "maxDuration": 300
    },
    "api/auth.js": {
      "maxDuration": 15
    },
    "api/chats.js": {
      "maxDuration": 15
    },
    "api/image.js": {
      "maxDuration": 60
    },
    "api/share.js": {
      "maxDuration": 15
    },
    "api/hub.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/v1/chat/completions",
      "destination": "/api/chat"
    },
    {
      "source": "/v1/models",
      "destination": "/api/models"
    }
  ],
  "headers": [
    {
      "source": "/v1/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Authorization, Content-Type"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
